# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Each teammate uses their OWN free accounts (one account per person).
# The same keys go in GitHub repository secrets for CI/Action runs.
# Setup steps: docs/setup-models.md

GROQ_API_KEY=          # https://console.groq.com  -> API Keys
OPENROUTER_API_KEY=    # https://openrouter.ai     -> Keys
GEMINI_API_KEY=        # https://aistudio.google.com -> Get API key (free, no card)
CEREBRAS_API_KEY=      # optional for now (needs a card); leave empty
VLLM_API_KEY=EMPTY     # self-hosted vLLM on Kaggle accepts any value
